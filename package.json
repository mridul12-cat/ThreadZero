{
  "name": "threadzero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src e2e server api scripts *.ts *.js *.json index.html",
    "format:check": "prettier --check src e2e server api scripts *.ts *.js *.json index.html",
    "test:groq": "node scripts/groq-smoke.mjs",
    "test:secrets": "node scripts/verify-client-secrets.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@huggingface/transformers": "^4.3.1",
    "@xyflow/react": "^12.10.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.12"
  }
}
